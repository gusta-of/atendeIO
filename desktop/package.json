{
  "name": "atendeio-desktop",
  "productName": "atendeIO",
  "version": "0.1.0",
  "description": "atendeIO — agente desktop (câmeras e reconhecimento rodam na sua máquina)",
  "author": "atendeIO",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "web": "node -e \"require('child_process').spawnSync('pnpm',['--dir',require('./paths').webDir(),'run','build:desktop'],{stdio:'inherit'})\"",
    "engine": "python3 engine/build_engine.py",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "br.com.atendeio.desktop",
    "productName": "atendeIO",
    "directories": { "output": "dist" },
    "files": ["main.js", "assets/**", "package.json"],
    "extraResources": [{ "from": "engine-dist/atendeio-engine", "to": "engine" }],
    "asar": true,
    "win": { "icon": "assets/icon.png", "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "linux": { "icon": "assets/icon.png", "category": "Utility", "target": ["AppImage"] },
    "mac": { "icon": "assets/icon.png", "category": "public.app-category.business", "target": ["dmg"], "hardenedRuntime": true }
  }
}
